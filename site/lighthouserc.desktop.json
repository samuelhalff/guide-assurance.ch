{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-out.mjs 4173",
      "startServerReadyPattern": "listening on",
      "startServerReadyTimeout": 15000,
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/assurance-maladie/",
        "http://127.0.0.1:4173/frontaliers/",
        "http://127.0.0.1:4173/assurance-maladie/primes/",
        "http://127.0.0.1:4173/assurance-maladie/comparateur/",
        "http://127.0.0.1:4173/en/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage",
        "preset": "desktop",
        "blockedUrlPatterns": [
          "*googletagmanager.com*",
          "*google-analytics.com*",
          "*analytics.google.com*",
          "*posthog.com*",
          "*challenges.cloudflare.com*"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 150,
            "aggregationMethod": "median"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}
